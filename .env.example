# ── API keys (store in OS keychain via `leantrade init` or paste here) ──────
LEANTRADE_FMP_API_KEY=
LEANTRADE_POLYGON_API_KEY=
LEANTRADE_TIINGO_API_KEY=
LEANTRADE_EODHD_API_KEY=
LEANTRADE_ALPHA_VANTAGE_API_KEY=

# ── LLM providers ────────────────────────────────────────────────────────────
LEANTRADE_OPENAI_API_KEY=
LEANTRADE_OPENAI_BASE_URL=https://api.openai.com/v1
LEANTRADE_ANTHROPIC_API_KEY=

# ── SEC EDGAR (required for US filings; use "FirstName LastName email@example.com") ─
LEANTRADE_SEC_USER_AGENT=

# ── Application (optional overrides) ─────────────────────────────────────────
# LEANTRADE_DATA_DIR=./data
# LEANTRADE_CONFIG_FILE=./config/leantrade.toml
# LEANTRADE_PORT=8787
# LEANTRADE_LOG_LEVEL=INFO
