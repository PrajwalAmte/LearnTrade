# ── API keys (store in OS keychain via `learntrade init` or paste here) ──────
LEARNTRADE_FMP_API_KEY=
LEARNTRADE_POLYGON_API_KEY=
LEARNTRADE_TIINGO_API_KEY=
LEARNTRADE_EODHD_API_KEY=
LEARNTRADE_ALPHA_VANTAGE_API_KEY=

# ── LLM providers ────────────────────────────────────────────────────────────
LEARNTRADE_OPENAI_API_KEY=
LEARNTRADE_OPENAI_BASE_URL=https://api.openai.com/v1
LEARNTRADE_ANTHROPIC_API_KEY=

# ── SEC EDGAR (required for US filings; use "FirstName LastName email@example.com") ─
LEARNTRADE_SEC_USER_AGENT=

